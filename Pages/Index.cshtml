@page
@model grad_manager.Pages.IndexModel

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Home Page</h1>
        </div>

        <a asp-page="/Applications/Create" class="btn btn-primary">
            Create Application
        </a>
    </div>


    <div class="dashboard-stats">

        <div class="stat-card">
            <span>Total Applications</span>
            <strong>@Model.TotalApplications</strong>
        </div>

        <div class="stat-card">
            <span>Applications Submitted</span>
            <strong>@Model.ApplicationsSubmitted</strong>
        </div>

        <div class="stat-card">
            <span>Interviews</span>
            <strong>@Model.Interviews</strong>
        </div>

        <div class="stat-card">
            <span>Offers</span>
            <strong>@Model.Offers</strong>
        </div>

    </div>


    <div class="dashboard-section">

        <div class="section-header">
            <h2>Upcoming Application Deadlines</h2>

            <a asp-page="/Applications/Index">
                View all applications
            </a>
        </div>

        @if (Model.UpcomingDeadlines.Count == 0)
        {
            <div class="empty-state">
                <p>No upcoming deadlines</p>
            </div>
        }
        else
        {
            <div class="dashboard-applications">

                @foreach (var application in Model.UpcomingDeadlines)
                {
                    <a asp-page="/Applications/Details"
                       asp-route-id="@application.Id"
                       class="dashboard-application">

                        <div>
                            <strong>@application.Company</strong>
                            <span>@application.Role</span>
                        </div>

                        <div class="dashboard-deadline">
                            <span>Deadline</span>
                            <strong>
                                @application.Deadline?.ToString("dd/MM/yyyy")
                            </strong>
                        </div>

                    </a>
                }

            </div>
        }

    </div>

    <div class="dashboard-section">

        <div class="section-header">
            <h2>Upcoming Task Deadlines</h2>

            <a asp-page="/ApplicationTasks/Index">
                View all Tasks
            </a>
        </div>

        @if (Model.UpcomingTaskDeadlines.Count == 0)
        {
            <div class="empty-state">
                <p>No upcoming task deadlines</p>
            </div>
        }
        else
        {
            <div class="dashboard-applications">

                @foreach (var applicationTask in Model.UpcomingTaskDeadlines)
                {
                    <div class="task-row @(applicationTask.Finished ? "task-done" : "")">

                        <form method="post"
                            asp-page-handler="SetFinished"
                            class="task-check">

                            <input type="hidden"
                                name="id"
                                value="@applicationTask.Id" />

                            <input type="checkbox"
                                name="finished"
                                value="true"
                                checked="@applicationTask.Finished"
                                onchange="this.form.submit()" />
                        </form>

                        <a asp-page="./ApplicationTasks/Details"
                            asp-route-id="@applicationTask.Id"
                            class="task-link">

                            <div class="task-info">
                                <strong>@applicationTask.Task</strong>

                                @if (applicationTask.Application != null)
                                {
                                    <span class="task-application">
                                        @applicationTask.Application.Company ·
                                        @applicationTask.Application.Role
                                    </span>
                                }
                            </div>

                            @if (applicationTask.Deadline.HasValue)
                            {
                                <span class="task-deadline">
                                    @applicationTask.Deadline.Value.ToString("dd/MM/yyyy")
                                </span>
                            }

                        </a>
                    </div>
                }

            </div>
        }

    </div>

</div>