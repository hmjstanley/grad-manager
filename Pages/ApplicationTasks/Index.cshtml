@page
@model grad_manager.Pages.ApplicationTasks.IndexModel

<div class="applications-page">

    <div class="page-header">
        <h1>Tasks</h1>
        <a asp-page="./Create" class="btn btn-primary">
            Create Task
        </a>
    </div>

    <h3 class="task-header">To do Tasks</h3>

    @if (Model.ToDoTasks.Count == 0)
    {
        <p class="no-task">You don't have any todo tasks</p>
    }
    else
    {
        <div class="applications-table">

            @foreach (var applicationTask in Model.ToDoTasks)
            {
                <div class="task-row @(applicationTask.Finished ? "task-done" : "")">

                    <form method="post"
                          asp-page-handler="SetFinished"
                          class="task-check">

                        <input type="hidden"
                               name="id"
                               value="@applicationTask.Id" />

                        <input type="checkbox"
                               name="finished"
                               value="true"
                               checked="@applicationTask.Finished"
                               onchange="this.form.submit()" />
                    </form>

                    <a asp-page="./Details"
                       asp-route-id="@applicationTask.Id"
                       class="task-link">

                        <div class="task-info">
                            <strong>@applicationTask.Task</strong>

                            @if (applicationTask.Application != null)
                            {
                                <span class="task-application">
                                    @applicationTask.Application.Company ·
                                    @applicationTask.Application.Role
                                </span>
                            }
                        </div>

                        @if (applicationTask.Deadline.HasValue)
                        {
                            <span class="task-deadline">
                                @applicationTask.Deadline.Value.ToString("dd/MM/yyyy")
                            </span>
                        }

                    </a>
                </div>
            }
        </div>
    }

    <h3 class="task-header-2">Completed Tasks</h3>

    @if (Model.CompletedTasks.Count == 0)
    {
        <p class="no-task">You don't have any completed tasks</p>
    }
    else
    {
        <div class="applications-table">

            @foreach (var applicationTask in Model.CompletedTasks)
            {
                <div class="task-row task-done">

                    <form method="post"
                          asp-page-handler="SetFinished"
                          class="task-check">

                        <input type="hidden"
                               name="id"
                               value="@applicationTask.Id" />

                        <input type="checkbox"
                               name="finished"
                               value="true"
                               checked="@applicationTask.Finished"
                               onchange="this.form.submit()" />
                    </form>

                    <a asp-page="./Details"
                       asp-route-id="@applicationTask.Id"
                       class="task-link">

                        <div class="task-info">
                            <strong>@applicationTask.Task</strong>

                            @if (applicationTask.Application != null)
                            {
                                <span class="task-application">
                                    @applicationTask.Application.Company ·
                                    @applicationTask.Application.Role
                                </span>
                            }
                        </div>

                        @if (applicationTask.Deadline.HasValue)
                        {
                            <span class="task-deadline">
                                @applicationTask.Deadline.Value.ToString("dd/MM/yyyy")
                            </span>
                        }

                    </a>
                </div>
            }
        </div>
    }
</div>