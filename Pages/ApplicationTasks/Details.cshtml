@page
@model grad_manager.Pages.ApplicationTasks.DetailsModel

<div class="application-details">

    @if (Model.ApplicationTask.Application != null)
    {
        <div class="details-header">
            <div>
                <h1>@Model.ApplicationTask.Application.Company</h1>
                <p>@Model.ApplicationTask.Application.Role</p>
            </div>
        </div>
    }

    <div class="details-card">

        <div class="details-grid">

            <div class="details-field">
                <p>@Model.ApplicationTask.Task</p>
            </div>

            <div class="details-field">
                <span>Deadline</span>
                <p>@Model.ApplicationTask.Deadline?.ToString("dd/MM/yyyy")</p>
            </div>

        </div>

        <div class="application-actions">

            <a asp-page="./Index" class="back-link">
                Back to Tasks
            </a>

            <div class="action-buttons">

                <a asp-page="./Delete"
                   asp-route-id="@Model.ApplicationTask.Id"
                   class="delete-button"
                   aria-label="Delete task"
                   title="Delete task">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6l-1 14H6L5 6"></path>
                        <path d="M10 11v5"></path>
                        <path d="M14 11v5"></path>
                        <path d="M9 6V4h6v2"></path>
                    </svg>
                </a>

                <a asp-page="./Edit"
                   asp-route-id="@Model.ApplicationTask.Id"
                   class="save-button">
                    Edit Task
                </a>

            </div>

        </div>

    </div>

</div>