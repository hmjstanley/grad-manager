@page
@model grad_manager.Pages.Applications.IndexModel

<div class="applications-page">

    <div class="page-header">
        <h1>Applications</h1>

        <a asp-page="./Create" class="btn btn-primary">
            Create Application
        </a>
    </div>

    @if (Model.Applications.Count == 0)
    {
        <p>You don't have any applications yet.</p>
    }
    else
    {
        <div class="applications-table">

            <!-- Headings -->
            <div class="application-headings">
                <span>Company</span>
                <span>Role</span>
                <span>Location</span>
                <span>Deadline</span>
                <span>Date Applied</span>
                <span>Status</span>
            </div>

            <!-- Application rows -->
            @foreach (var application in Model.Applications)
            {
                <a asp-page="./Details"
                   asp-route-id="@application.Id"
                   class="application-row">

                    <strong>@application.Company</strong>

                    <span>@application.Role</span>

                    <span>@application.Location</span>

                    <span>@application.Deadline?.ToString("dd/MM/yyyy")</span>

                    <span>@application.DateApplied?.ToString("dd/MM/yyyy")</span>

                    <span>@application.Status</span>

                </a>
            }

        </div>
    }

</div>