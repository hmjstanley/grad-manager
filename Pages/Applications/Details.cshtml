@page
@model grad_manager.Pages.Applications.DetailsModel

<div class="application-details">

    <div class="details-header">
        <div>
            <h1>@Model.Application.Company</h1>
            <p>@Model.Application.Role</p>
        </div>
    </div>

    <div class="details-card">

        <div class="details-grid">

            <div class="details-field">
                <span>Company</span>
                <p>@Model.Application.Company</p>
            </div>

            <div class="details-field">
                <span>Role</span>
                <p>@Model.Application.Role</p>
            </div>

            <div class="details-field">
                <span>Location</span>
                <p>@Model.Application.Location</p>
            </div>

            <div class="details-field">
                <span>Stage</span>
                <p class="stage-badge">@Model.Application.Stage</p>
            </div>

            <div class="details-field">
                <span>Deadline</span>
                <p>@Model.Application.Deadline?.ToString("dd/MM/yyyy")</p>
            </div>

            <div class="details-field">
                <span>Date Applied</span>
                <p>@Model.Application.DateApplied?.ToString("dd/MM/yyyy")</p>
            </div>

            <div class="details-field">
                <span>URL</span>
                <p>
                    @if (!string.IsNullOrWhiteSpace(Model.Application.Url))
                    {
                        <a href="@Model.Application.Url" target="_blank" rel="noopener noreferrer">
                            @Model.Application.Url
                        </a>
                    }
                    else
                    {
                        <span>Not provided</span>
                    }
                </p>
            </div>

            <div class="details-field">
                <span>Notes</span>
                <p>@Model.Application.Notes</p>
            </div>

        </div>

        <div class="application-actions">

            <a asp-page="./Index" class="back-link">
                Back to Applications
            </a>

            <div class="action-buttons">

                <a asp-page="./Delete"
                   asp-route-id="@Model.Application.Id"
                   class="delete-button"
                   aria-label="Delete application"
                   title="Delete application">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6l-1 14H6L5 6"></path>
                        <path d="M10 11v5"></path>
                        <path d="M14 11v5"></path>
                        <path d="M9 6V4h6v2"></path>
                    </svg>
                </a>

                <a asp-page="./Edit"
                   asp-route-id="@Model.Application.Id"
                   class="save-button">
                    Edit Application
                </a>

            </div>

        </div>

    </div>

</div>