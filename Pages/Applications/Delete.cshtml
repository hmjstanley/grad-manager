@page
@model grad_manager.Pages.Applications.DeleteModel

<div class="application-details">

    <div class="details-header">
        <div>
            <h1>Delete Application</h1>
        </div>
    </div>

    <div class="details-card">

        <div class="details-grid">

            <div class="details-field">
                <span>Company</span>
                <p>@Model.Application.Company</p>
            </div>

            <div class="details-field">
                <span>Role</span>
                <p>@Model.Application.Role</p>
            </div>

            <div class="details-field">
                <span>Location</span>
                <p>@Model.Application.Location</p>
            </div>

            <div class="details-field">
                <span>Stage</span>
                <p class="stage-badge">@Model.Application.Stage</p>
            </div>

        </div>

        <div class="delete-warning">
            <strong>Are you sure you want to delete this application?</strong>
            <span>Deleting this application will permanently remove it from your tracker and cannot be undone :(</span>
        </div>

        <div class="application-actions">

            <a asp-page="./Details"
               asp-route-id="@Model.Application.Id"
               class="back-link">
                Back to Application
            </a>

            <form method="post">
                <input type="hidden" asp-for="Application.Id" />

                <button type="submit" class="delete-confirm-button">
                    Delete Application
                </button>
            </form>

        </div>

    </div>

</div>