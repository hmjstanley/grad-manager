@page
@model grad_manager.Pages.Applications.CreateModel

<div class="create-page">

    <div class="create-header">
        <h1>Create Application</h1>
    </div>

    <div class="create-card">

        <form method="post">

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="Application.Company"></label>
                    <input asp-for="Application.Company" placeholder="e.g. Accenture" />
                    <span asp-validation-for="Application.Company"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Application.Role"></label>
                    <input asp-for="Application.Role" placeholder="e.g. Graduate Software Developer" />
                    <span asp-validation-for="Application.Role"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Application.Location"></label>
                    <input asp-for="Application.Location" placeholder="e.g. Newcastle" />
                    <span asp-validation-for="Application.Location"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Application.Stage"></label>

                    <select asp-for="Application.Stage">
                        <option value="Interested">Interested</option>
                        <option value="Application Started">Application Started</option>
                        <option value="Applied">Applied</option>
                        <option value="Online Test">Online Test</option>
                        <option value="Interview">Interview</option>
                        <option value="Assessment Centre">Assessment Centre</option>
                        <option value="Offer">Offer</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Withdrawn">Withdrawn</option>
                    </select>

                    <span asp-validation-for="Application.Stage"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Application.Deadline"></label>
                    <input asp-for="Application.Deadline" type="date" />
                    <span asp-validation-for="Application.Deadline"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Application.DateApplied"></label>
                    <input asp-for="Application.DateApplied" type="date" />
                    <span asp-validation-for="Application.DateApplied"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Application.Url"></label>
                    <input asp-for="Application.Url"
                        type="url"
                        placeholder="e.g. https://www.example.com/graduate-scheme" />
                    <span asp-validation-for="Application.Url"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Application.Notes"></label>
                    <textarea asp-for="Application.Notes"
                            rows="5"
                            placeholder="Add any notes about this application..."></textarea>
                    <span asp-validation-for="Application.Notes"></span>
                </div>

            </div>

            <div class="form-actions">
                <a asp-page="./Index" class="back-link">
                    Back to Applications
                </a>

                <button type="submit" class="save-button">
                    Save Application
                </button>
            </div>

        </form>

    </div>

</div>